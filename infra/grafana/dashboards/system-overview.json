{
  "id": null,
  "title": "DETE — System Overview",
  "uid": "dete-system-overview",
  "version": 1,
  "schemaVersion": 38,
  "tags": ["dete"],
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Services Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{service}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {}
}
